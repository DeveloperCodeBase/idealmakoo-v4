# =============================================================================
# IDEAL MAKOO ENTERPRISE PLATFORM - ENVIRONMENT CONFIGURATION (.env.example)
# =============================================================================
# نکته مهم: در محیط توسعه و پیش‌نمایش، سیستم بدون نیاز به کلیدهای خارجی
# در حالت خودکفا (sandbox) با داده‌های پیش‌فرض کار می‌کند.
# برای محیط سرور اصلی، این فایل را به .env کپی کرده و مقادیر واقعی را وارد کنید.

# ۱. هویت محیط و دامنه
NODE_ENV="development"
APP_ENV="staging"                          # مقادیر مجاز: development | staging | production
APP_PORT="3000"
APP_DOMAIN="localhost:3000"                # در سرور اصلی: idealmakoo.com
PUBLIC_BASE_URL="http://localhost:3000"    # در سرور اصلی: https://idealmakoo.com
RELEASE_SHA="local-dev-build"
INDEXING_ENABLED="false"                   # فقط روی دامنه اصلی idealmakoo.com برابر true قرار گیرد

# ۲. پایگاه داده PostgreSQL (مجهز به pgvector)
DATABASE_URL="postgresql://idealmakoo_app:CHANGE_ME@127.0.0.1:5432/idealmakoo_db"
DATABASE_MIGRATION_URL="postgresql://idealmakoo_migrator:CHANGE_ME@127.0.0.1:5432/idealmakoo_db"

# ۳. کلیدهای امنیتی داخلی (در اسکریپت نصب اوبونتو با CSPRNG به صورت خودکار تولید می‌شوند)
PAYLOAD_SECRET="CHANGE_ME_WITH_32_BYTES_CSPRNG_HEX"
SESSION_SECRET="CHANGE_ME_WITH_32_BYTES_CSPRNG_HEX"
MFA_ENCRYPTION_KEY="CHANGE_ME_WITH_32_BYTES_CSPRNG_HEX"
PREVIEW_TOKEN_SECRET="CHANGE_ME_WITH_32_BYTES_CSPRNG_HEX"
UNSUBSCRIBE_HMAC_SECRET="CHANGE_ME_WITH_32_BYTES_CSPRNG_HEX"

# ۴. ذخیره‌سازی رسانه و فایل‌های خصوصی
MEDIA_STORAGE_DRIVER="local"               # مقادیر مجاز: local | s3
MEDIA_ROOT="/var/www/idealmakoo/shared/media"
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ۵. استودیو هوش مصنوعی و چت‌بات مستند (OpenRouter)
AI_PROVIDER_MODE="auto"                    # auto: در صورت وجود کلید از OpenRouter و در غیر این صورت از شبیه‌ساز محلی استفاده می‌کند
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_WEBHOOK_SECRET=""
AI_MONTHLY_BUDGET_USD="100.00"

# ۶. حالت ارسال اعلان‌ها و سرویس‌های پیام‌رسان
NOTIFICATIONS_MODE="sandbox"               # مقادیر مجاز: sandbox | live (در حالت sandbox هیچ پیام بیرونی ناخواسته‌ای ارسال نمی‌شود)
SANDBOX_ALLOWED_RECIPIENTS="test@idealmako.invalid,+989000000000"

# ۶.الف. پیامک و OTP کاوه‌نگار (Kavenegar)
KAVENEGAR_API_KEY=""
KAVENEGAR_SENDER_LINE=""
KAVENEGAR_OTP_TEMPLATE="idealmakoo-verify"

# ۶.ب. وب پوش نجوا (Najva) و استاندارد VAPID
NAJVA_API_KEY=""
NAJVA_WEBSITE_ID=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:info@idealmakoo.com"

# ۶.ج. بات و کانال رسمی تلگرام (Telegram Bot API)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHANNEL_ID="@idealmakoo"
TELEGRAM_WEBHOOK_SECRET=""

# ۶.د. سرویس ایمیل (Postfix Send-Only محلی یا SMTP / Resend)
EMAIL_PROVIDER="smtp"                      # مقادیر مجاز: smtp | resend | sandbox
SMTP_HOST="127.0.0.1"
SMTP_PORT="25"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM_ADDRESS="noreply@idealmakoo.com"
EMAIL_FROM_NAME="کارخانه دندان‌سازی و مواد دندانی ایده‌آل ماکو"
RESEND_API_KEY=""

# ۷. حساب اولیه مالک برای Bootstrap یک‌بارمصرف
OWNER_BOOTSTRAP_EMAIL="owner@idealmakoo.com"